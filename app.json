{
  "expo": {
    "name": "Clink",
    "slug": "clink",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clink",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FEFFF8",
    "ios": {
      "bundleIdentifier": "app.clink.family",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Clink finds your partner's phone on your home Wi-Fi so you can share rewards between phones."
      }
    },
    "android": {
      "package": "app.clink.family",
      "adaptiveIcon": {
        "backgroundColor": "#4392F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEFFF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Clink uses your photos so you can add a picture of your child or of a goal they reached.",
          "cameraPermission": "Clink uses the camera to take a picture of your child or of a goal they reached.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Clink uses the camera to take photos and to scan the pairing code on your partner's phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Clink saves photos of reached goals to a Clink album.",
          "savePhotosPermission": "Clink saves photos of reached goals to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Clink uses the microphone so you can record a message for your children\u2019s celebrations.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#4392F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
